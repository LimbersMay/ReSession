    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "re-design": "github:LimbersMay/ReDesign#v1.1.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2",
    "wxt": "^0.21.4"
  }
